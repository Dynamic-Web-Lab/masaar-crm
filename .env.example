# -----------------------------------------------
# Masaar CRM — Environment Variables
# Copy to .env and fill in your values
# -----------------------------------------------

# Server
PORT=8080
APP_ENV=development

# PostgreSQL (pgvector enabled)
DATABASE_URL=postgres://masaar:masaar@localhost:5432/masaar?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT — change JWT_SECRET to a long random string in production
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# WhatsApp Business API
WA_VERIFY_TOKEN=masaar-webhook-token
WA_API_VERSION=v19.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Ollama (local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# BuyOrSell24 Real Estate API (by Dynamic Web Lab) — Optional
# Product & Pricing: https://dynamicweblab.com/products/real-estate-data-api/
# API Docs: https://data.buyorsell24.com/redoc
# Setup: Contact Dynamic Web Lab via the link above to get your API token
# Masaar Pro users get credits included; open-source users contact for pricing
# Leave empty to disable real estate features
BOS24_API_TOKEN=

# Email — Optional SMTP configuration
# Supports sending invoices, proposals, and follow-ups via email
# Leave empty to disable email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@masaar.local
SMTP_FROM_NAME=Masaar CRM
