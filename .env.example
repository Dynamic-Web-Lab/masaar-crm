# ──────────────────────────────────────────────────────────────────────────
# Masaar CRM Environment Configuration
# Copy this file to .env and update values for your deployment
# For Docker: source this file or load it via docker-compose
# ──────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# For local development:
#   DATABASE_URL=postgres://masaar:masaar@localhost:5432/masaar?sslmode=disable
# For Docker: postgres://masaar:masaar@postgres:5432/masaar?sslmode=disable
DB_USER=masaar
DB_PASSWORD=change-me-to-strong-password
DB_NAME=masaar
DATABASE_URL=postgres://masaar:change-me-to-strong-password@postgres:5432/masaar?sslmode=disable

# ─── Redis ───────────────────────────────────────────────────────────────────
# For local: redis://localhost:6379
# For Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ──────────────────────────────────────────────────────
# IMPORTANT: Generate a random 32+ character string for production
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── WhatsApp Business API (Optional) ─────────────────────────────────────────
# Get these from: https://business.facebook.com/
# Webhook verification token (can be any string you choose)
WA_VERIFY_TOKEN=masaar-webhook-token
WA_API_VERSION=v19.0

# For sending messages (optional)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BASE_URL=https://graph.instagram.com

# ─── SMTP Email Service (Optional) ────────────────────────────────────────────
# For payment confirmations, invoices, and notifications
# Example Gmail: smtp.gmail.com (use app-specific password)
# Example AWS SES: email-smtp.region.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@masaar.local
SMTP_FROM_NAME=Masaar CRM

# ─── Ollama LLM (Optional) ────────────────────────────────────────────────────
# For AI thread summaries and lead scoring
# Pulls ~5GB llama3 model on first run
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ─── BuyOrSell24 Integration (Optional) ───────────────────────────────────────
# For real estate property listings and market data
# Get token from: https://dynamicweblab.com/
BOS24_TOKEN=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# API URL for frontend client
# For local: http://localhost:8080
# For Docker: http://masaar:8080 or http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000
