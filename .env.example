# -----------------------------------------------
# Masaar CRM — Environment Variables
# Copy to .env and fill in your values
# -----------------------------------------------

# Server
PORT=8080
APP_ENV=development

# PostgreSQL (pgvector enabled)
DATABASE_URL=postgres://masaar:masaar@localhost:5432/masaar?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT — change JWT_SECRET to a long random string in production
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# WhatsApp Business API (Inbound + Outbound)
# Get credentials from: https://business.facebook.com/
# Webhook receiver for inbound messages (required)
WA_VERIFY_TOKEN=masaar-webhook-token
WA_API_VERSION=v19.0

# Outbound messaging (optional - required to send messages from CRM)
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-business-account-token
WA_BASE_URL=https://graph.instagram.com

# AI Services — Choose one:

# Option 1: Google Gemini API (Recommended for MVP - $0.40/month)
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-1.5-flash  # or gemini-1.5-pro for more capabilities

# Option 2: Local Ollama LLM (Requires 8GB RAM, 4 CPU cores)
# Only use if not shared server, or after MVP scales
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3

# BuyOrSell24 Real Estate API (by Dynamic Web Lab) — Optional
# Product & Pricing: https://dynamicweblab.com/products/real-estate-data-api/
# API Docs: https://data.buyorsell24.com/redoc
# Setup: Contact Dynamic Web Lab via the link above to get your API token
# Masaar Pro users get credits included; open-source users contact for pricing
# Leave empty to disable real estate features
BOS24_API_TOKEN=

# Email — Optional SMTP configuration
# Supports sending invoices, proposals, and follow-ups via email
# Leave empty to disable email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@masaar.local
SMTP_FROM_NAME=Masaar CRM
