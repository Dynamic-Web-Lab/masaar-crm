# ──────────────────────────────────────────────────────────────────────────
# Masaar CRM Environment Configuration
# Copy this file to .env and update values for your deployment
# For Docker: source this file or load it via docker-compose
# ──────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production

# Single-tenant company UUID — matches the seed in migration 00000.
APP_COMPANY_ID=00000000-0000-0000-0000-000000000001

# CORS — comma-separated allowed origins.
# In production set to your frontend domain, e.g. https://crm.yourcompany.ae
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# For local development:
#   DATABASE_URL=postgres://masaar:masaar@localhost:5432/masaar?sslmode=disable
# For Docker: postgres://masaar:masaar@postgres:5432/masaar?sslmode=disable
DB_USER=masaar
DB_PASSWORD=change-me-to-strong-password
DB_NAME=masaar
DATABASE_URL=postgres://masaar:change-me-to-strong-password@postgres:5432/masaar?sslmode=disable

# ─── Redis ───────────────────────────────────────────────────────────────────
# For local: redis://localhost:6379
# For Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# ─── JWT Authentication ──────────────────────────────────────────────────────
# IMPORTANT: Generate a random 32+ character string for production
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── WhatsApp Business API (Optional) ─────────────────────────────────────────
# Get these from: https://business.facebook.com/
# Webhook verification token (can be any string you choose)
WA_VERIFY_TOKEN=masaar-webhook-token
WA_API_VERSION=v19.0

# For sending messages (optional)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BASE_URL=https://graph.facebook.com/v19.0

# App Secret — found in Meta Developer Portal → Your App → Settings → Basic
# Required to validate X-Hub-Signature-256 on inbound webhooks (strongly recommended)
WA_APP_SECRET=

# ─── SMTP Email Service (Optional) ────────────────────────────────────────────
# For payment confirmations, invoices, and notifications
# Example Gmail: smtp.gmail.com (use app-specific password)
# Example AWS SES: email-smtp.region.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@masaar.local
SMTP_FROM_NAME=Masaar CRM

# ─── Magic Link (Passwordless Login) ─────────────────────────────────────
# Frontend base URL for magic link emails
MAGIC_LINK_BASE_URL=http://localhost:3000
# Token expiry in minutes (default: 15)
MAGIC_LINK_EXPIRY_MIN=15
# Rate limit: max requests per email per hour (default: 3)
MAGIC_LINK_RATE_LIMIT=3

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Choose: "ollama" (local, default) or "gemini" (Google Cloud)
AI_PROVIDER=ollama

# Ollama — used when AI_PROVIDER=ollama
# For AI thread summaries and lead scoring
# Default: mistral (4.4GB, fast) - also try: llama3 (5GB), phi3 (2GB)
# Run Ollama first: docker run -d --name ollama -p 11434:11434 --network buyorsell24_masaar_shared -v ollama_data:/root/.ollama ollama/ollama
# Then pull model: docker exec ollama ollama pull mistral
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# Google Gemini — used when AI_PROVIDER=gemini
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── BuyOrSell24 Integration (Optional) ───────────────────────────────────────
# For real estate property listings and market data
# Product & Pricing: https://dynamicweblab.com/products/real-estate-data-api/
# API Docs: https://data.buyorsell24.com/redoc
# Setup: Contact Dynamic Web Lab via the link above to get your API token
# Masaar Pro users get credits included; open-source users contact for pricing
# Leave empty to disable real estate features
BOS24_API_TOKEN=
# Override base URL — use https://test.data.buyorsell24.com for the staging/test environment
# Defaults to https://data.buyorsell24.com (production) if not set
BOS24_BASE_URL=

# ─── Demo Mode (Optional) ─────────────────────────────────────────────────────
# Enable a one-click demo login button on the login page.
# The demo user (demo@masaar.local) has Viewer role — read-only access.
# Set to false in production unless you are running a public product demo.
DEMO_MODE=false
DEMO_EMAIL=demo@masaar.local

# ─── Frontend ─────────────────────────────────────────────────────────────────
# API URL for frontend client
# For local: http://localhost:8080
# For Docker: http://masaar:8080 or http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000

# Demo mode toggle — set to true to show the "Try Demo" hero on the login page
# When enabled, visitors see a one-click demo CTA instead of the login form.
# Requires demo user data to be seeded (run seed script).
NEXT_PUBLIC_DEMO_ENABLED=false
