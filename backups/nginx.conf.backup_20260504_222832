    # ============================================
    # search.buyorsell24.com (Meilisearch)
    # ============================================

    # Upstream for Meilisearch
    upstream meilisearch {
        least_conn;
        server meilisearch:7700 max_fails=3 fail_timeout=30s;
    }

    # HTTP to HTTPS redirect
    server {
        listen 80;
        listen [::]:80;
        server_name search.buyorsell24.com;

        # ACME challenge location
        location /.well-known/acme-challenge/ {
            root /var/www/acme;
        }

        # Redirect all other traffic to HTTPS
        location / {
            return 301 https://$server_name$request_uri;
        }
    }

    # HTTPS server for Meilisearch
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name search.buyorsell24.com;

        ssl_certificate /etc/letsencrypt/live/search.buyorsell24.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/search.buyorsell24.com/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Root location - proxy to Meilisearch
        location / {
            limit_req zone=general_limit burst=20 nodelay;

            proxy_pass http://meilisearch;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;

            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 120s;
            proxy_buffering off;
        }

        # Health check endpoint
        location /health {
            access_log off;
            proxy_pass http://meilisearch;
            proxy_http_version 1.1;
        }
        # Masaar CRM
    server {
        listen 80;
        server_name masaar.dynamicweblab.com;
        return 301 https://$server_name$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name masaar.dynamicweblab.com;

        ssl_certificate /etc/letsencrypt/live/masaar.dynamicweblab.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/masaar.dynamicweblab.com/privkey.pem;

        # API routes
        location /api/ {
