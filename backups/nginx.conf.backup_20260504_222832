user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript
               application/x-javascript application/xml+rss
               application/javascript application/json;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/s;
    limit_req_zone $binary_remote_addr zone=general_limit:10m rate=500r/s;

    # Upstream servers
    upstream python_api {
        least_conn;
        server api:8000 max_fails=3 fail_timeout=30s;
    }

    upstream go_api {
        least_conn;
        server api:8001 max_fails=3 fail_timeout=30s;
    }

    # ============================================
    # data.buyorsell24.com (Python API — LIVE)
    # ============================================

    # HTTP to HTTPS redirect
    server {
        listen 80;
        listen [::]:80;
        server_name data.buyorsell24.com;
        return 301 https://$server_name$request_uri;
    }

    # HTTPS server for Python API
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name data.buyorsell24.com;

        ssl_certificate /etc/letsencrypt/live/data.buyorsell24.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/data.buyorsell24.com/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Root location
        location / {
            limit_req zone=general_limit burst=20 nodelay;

            proxy_pass http://python_api;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;

            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 120s;
            proxy_buffering off;
        }

        # Health check endpoint (exclude from logs)
        location /health {
            access_log off;
            proxy_pass http://python_api;
            proxy_http_version 1.1;
        }
    }

